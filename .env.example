# Copy to .env (gitignored) and fill in. docker compose reads it automatically.
# `npm run keys:generate` prints fresh values for the first two.

# --- secrets -------------------------------------------------------------------
# AES-256-GCM key(s) sealing personal information at rest. "<id>:<base64>",
# newest first. Store a copy in a secrets manager: without it, encrypted
# columns cannot be read. Rotate by prepending a new id: 2:<new>,1:<old>
DATA_ENCRYPTION_KEYS=
# Keys the phone / email / ID-number lookup hashes. Set once; never change.
AUTH_PEPPER=
POSTGRES_PASSWORD=

# --- the first admin account ----------------------------------------------------
# Used ONCE, on a boot where no admin account exists yet, to create the first
# owner. It is ignored entirely after that, so it cannot be used to     re-take an
# installation. That account's first sign-in must enrol two-factor
# authentication before it can do anything; every admin after it is created
# from inside the portal (Admin accounts tab).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_PASSWORD=
# How long a fully signed-in admin session lasts, and how long the gap between
# password and second factor may be before the half-finished sign-in expires.
ADMIN_SESSION_HOURS=12
ADMIN_MFA_WINDOW_MINUTES=10
# Failed passwords before an admin account locks, and for how long.
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
# Demo mode for admin two-factor, the counterpart of OTP_ECHO below: the
# current authenticator code is shown on the sign-in screen, so the portal can
# be set up on a machine with no authenticator app.
#
# This removes the second factor. Anyone who has the password is handed the
# code, so the portal is protected by one factor with extra steps. Use it to
# get started or to demo, then unset it. MUST be false where real admins sign
# in. The server prints a banner at every boot while it is on.
ADMIN_MFA_ECHO=false

# --- deployment ----------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8180
# Production: TLS to Postgres with certificate verification, HTTPS only.
# DATABASE_SSL=verify-full
# DATABASE_SSL_CA_FILE=/run/secrets/postgres-ca.pem
# FORCE_HTTPS=true

# --- messaging (OTP codes and reset links) -------------------------------------
OTP_TRANSPORT=console
# SMS_TRANSPORT=twilio
# EMAIL_TRANSPORT=sendgrid
# Demo mode shows codes/links on screen. MUST be false where real people log in.
OTP_ECHO=true

# --- uploaded imagery ------------------------------------------------------------
# The admin editor downscales to 1600px and re-encodes to WebP in the browser
# before uploading, so most files arrive well under these. They are the
# backstop for anything that bypasses the editor — and the pixel limit is what
# keeps a 12 MP camera photo from sitting behind a card on a 3G connection.
MAX_UPLOAD_MB=2
MAX_IMAGE_DIMENSION=2400
# Above this the upload is still accepted, but the editor warns about it.
WARN_UPLOAD_KB=400

# --- POPIA ---------------------------------------------------------------------
# Bump when the privacy notice changes; consents are recorded against it.
PRIVACY_NOTICE_VERSION=2026-09
# Days to keep raw analytics / audit rows (0 = forever). Daily counts are kept.
ANALYTICS_RETENTION_DAYS=730
AUDIT_RETENTION_DAYS=1825
# true shows the design's "Account not found" on Forgot Password — which
# reveals whether a number is registered. Leave false unless that's accepted.
AUTH_REVEAL_UNKNOWN_ACCOUNTS=false
# true = only real SA ID numbers (valid date + check digit). false = any 13 digits.
AUTH_STRICT_SA_ID=false
# Minutes of inactivity before a member session is force-expired, regardless
# of "Remember Me" — the real backstop, since a browser doesn't reliably drop
# a non-persistent cookie on close (installed/mobile PWAs keep it alive).
AUTH_IDLE_TIMEOUT_MINUTES=120

# ---------------------------------------------------------------------------
# Shared database (opt-in, per host)
# ---------------------------------------------------------------------------
# By default the app runs against its own bundled Postgres (the `db` service)
# and needs nothing here.
#
# To point it at the shared Odoo Postgres instead, first create the role and
# schema by hand (docs/SHARED_DATABASE.md), then uncomment the lines below. The
# network is created by the Odoo compose project and must already exist, or
# `compose up` refuses to start anything — get its name from `docker network ls`.
#COMPOSE_FILE=docker-compose.yml:docker-compose.shared-db.yml
#SHARED_DB_NETWORK=kaelo19test_default
#ASKNELSON_DATABASE_URL=postgres://asknelson_app:CHANGE_ME@kaelo19test-db-1:5432/kaelo19
# The schema the app's tables live in (the overlay defaults it to asknelson).
#ASKNELSON_DATABASE_SCHEMA=asknelson
# The Odoo Postgres container that the optional `dbproxy` service forwards
# 127.0.0.1:5433 to (`docker compose --profile tools up -d dbproxy`).
#SHARED_DB_HOST=kaelo19test-db-1
#
# A local `npm start` against the shared database goes through dbproxy, and
# reads these directly rather than via compose, so it needs:
#DATABASE_URL=postgres://asknelson_app:CHANGE_ME@127.0.0.1:5433/kaelo19
#DATABASE_SCHEMA=asknelson
#
# Seconds boot waits for the database to accept connections (default 60).
#DATABASE_CONNECT_TIMEOUT_SECONDS=60
